#!/usr/bin/env -S python3 -I
"""Resume a session parked by claude-park: restore the tab's original label, then
`claude --resume` in the session's original folder.

Usage: claude-wake <session-id>
"""
import glob, json, os, subprocess, sys

STATE = os.path.expanduser("~/.local/state/claude-park")

session_id = sys.argv[1]
pane_id = os.environ.get("HERDR_PANE_ID")

# Claude stores transcripts per project folder; recover the folder from the transcript.
cwd = os.path.expanduser("~")
for path in glob.glob(os.path.expanduser(f"~/.claude/projects/*/{session_id}.jsonl")):
    with open(path) as f:
        for line in f:
            rec = json.loads(line)
            if rec.get("cwd"):
                cwd = rec["cwd"]
                break

if pane_id:
    out = subprocess.run(["herdr", "pane", "get", pane_id], capture_output=True, text=True).stdout
    tab_id = json.loads(out)["result"]["pane"]["tab_id"]
    state = f"{STATE}/{session_id}.json"
    if os.path.exists(state):
        subprocess.run(["herdr", "tab", "rename", tab_id, json.load(open(state))["tab_label"]], capture_output=True)
        os.remove(state)

os.chdir(cwd)
os.execvp("claude", ["claude", "--resume", session_id])
