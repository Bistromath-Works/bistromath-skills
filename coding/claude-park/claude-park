#!/usr/bin/env -S python3 -I
"""Park idle Claude Code sessions in herdr or tmux to free memory, without losing the tab.

A herdr tab or tmux window whose Claude session has been idle longer than
IDLE_HOURS (and is not focused) gets: /exit sent to Claude, its label changed
to "💤 <chat title>" so you can see what the chat was about, and
`claude-wake <session-id>` pre-typed at the shell prompt. Press Enter to
resume; claude-wake restores the old label.

Usage: claude-park [--dry-run]
Env:   CLAUDE_PARK_IDLE_HOURS (default 24)
       CLAUDE_PARK_TMUX_SKIP  regex of tmux session names to leave alone
                              (default "@", which skips OpenRig agent seats)
"""
import json, os, re, shutil, subprocess, sys, time

IDLE_HOURS = float(os.environ.get("CLAUDE_PARK_IDLE_HOURS", 24))
TMUX_SKIP = re.compile(os.environ.get("CLAUDE_PARK_TMUX_SKIP", "@"))
SLEEP = "💤 "
SESSIONS = os.path.expanduser("~/.claude/sessions")
STATE = os.path.expanduser("~/.local/state/claude-park")
PERMISSION_PROMPT = "Do you want to proceed?"


def run(*args):
    return subprocess.run(args, capture_output=True, text=True, check=True).stdout


def herdr(*args):
    out = run("herdr", *args)
    return json.loads(out)["result"] if out.strip().startswith("{") else None


def alive(pid):
    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True


def session_record(pid):
    path = f"{SESSIONS}/{pid}.json"
    return json.load(open(path)) if os.path.exists(path) else None


def clean_title(title):
    """Claude sets the terminal title to '<spinner> <chat title>'; drop the spinner."""
    title = re.sub(r"^[^\w]+\s", "", title or "").strip()
    return "" if title == "Claude Code" else title


class Herdr:
    name = "herdr"

    def candidates(self):
        for agent in herdr("agent", "list")["agents"]:
            if agent["agent"] != "claude" or agent["focused"] or agent["agent_status"] != "idle":
                continue
            info = herdr("pane", "process-info", "--pane", agent["pane_id"])["process_info"]
            for proc in info.get("foreground_processes", []):
                if proc["name"] == "claude":
                    tab = herdr("tab", "get", agent["tab_id"])["tab"]
                    yield {"pane": agent["pane_id"], "label_id": agent["tab_id"], "pid": proc["pid"],
                           "label": tab["label"], "title": clean_title(agent.get("terminal_title_stripped"))}

    def type(self, pane, text, enter=False):
        herdr("pane", "run" if enter else "send-text", pane, text)

    def relabel(self, label_id, label):
        herdr("tab", "rename", label_id, label)


class Tmux:
    name = "tmux"

    def candidates(self):
        fmt = "\t".join(["#{pane_id}", "#{pane_pid}", "#{session_name}", "#{window_id}", "#{window_name}",
                         "#{pane_title}", "#{pane_active}", "#{window_active}", "#{session_attached}"])
        try:
            lines = run("tmux", "list-panes", "-a", "-F", fmt).splitlines()
        except subprocess.CalledProcessError:
            return  # no tmux server running
        for line in lines:
            pane, shell_pid, sess, window, wname, ptitle, pact, wact, attached = line.split("\t")
            if TMUX_SKIP.search(sess) or (pact == wact == "1" and attached != "0"):
                continue
            pids = subprocess.run(["pgrep", "-P", shell_pid, "-x", "claude"], capture_output=True, text=True).stdout.split()
            if not pids:
                continue
            screen = run("tmux", "capture-pane", "-p", "-t", pane)
            if PERMISSION_PROMPT in screen:
                continue
            yield {"pane": pane, "label_id": window, "pid": int(pids[0]), "label": wname, "title": clean_title(ptitle)}

    def type(self, pane, text, enter=False):
        run("tmux", "send-keys", "-t", pane, "-l", text)
        if enter:
            run("tmux", "send-keys", "-t", pane, "Enter")

    def relabel(self, label_id, label):
        run("tmux", "rename-window", "-t", label_id, label)


def park(backend, c, sess, dry_run):
    idle_h = (time.time() * 1000 - sess["updatedAt"]) / 3.6e6
    print(f"park {backend.name} {c['pane']} '{c['label']}' idle {idle_h:.0f}h session {sess['sessionId']}")
    if dry_run:
        return
    backend.type(c["pane"], "/exit", enter=True)
    for _ in range(30):
        if not alive(c["pid"]):
            break
        time.sleep(1)
    else:
        print(f"  claude pid {c['pid']} did not exit; leaving it alone", file=sys.stderr)
        return
    os.makedirs(STATE, exist_ok=True)
    with open(f"{STATE}/{sess['sessionId']}.json", "w") as f:
        json.dump({"backend": backend.name, "tab_label": c["label"]}, f)
    backend.relabel(c["label_id"], SLEEP + (c["title"] or c["label"])[:40])
    backend.type(c["pane"], f"claude-wake {sess['sessionId']}")


def main():
    dry_run = "--dry-run" in sys.argv
    cutoff_ms = time.time() * 1000 - IDLE_HOURS * 3.6e6
    backends = [b() for b, cmd in ((Herdr, "herdr"), (Tmux, "tmux")) if shutil.which(cmd)]
    for backend in backends:
        try:
            found = list(backend.candidates())
        except Exception as e:  # one broken backend must not stop the other
            print(f"{backend.name}: skipped ({e})", file=sys.stderr)
            continue
        for c in found:
            sess = session_record(c["pid"])
            if sess and sess.get("status") == "idle" and sess["updatedAt"] < cutoff_ms:
                park(backend, c, sess, dry_run)


if __name__ == "__main__":
    main()
